# ====== PawLife Backend — Environment Variables (mẫu) ======
# Copy thành .env và điền giá trị thật. KHÔNG commit file .env!

# --- App ---
PORT=3001

# --- Database (MySQL qua Prisma) ---
DATABASE_URL="mysql://user:password@localhost:3306/pawlife"

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION_TIME=7d

# --- Mailer (OTP) ---
MAIL_HOST=
MAIL_USER=
MAIL_PASS=

# --- Cloudflare R2 (Storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# --- Apple Wallet Pass (thẻ định danh thú cưng) ---
# Thư mục chứa chứng chỉ (tương đối với project root). Bên trong cần có:
#   signerCert.pem, signerKey.pem, wwdr.pem (và pass.p12 gốc để backup)
WALLET_CERTS_DIR=certs
# Mật khẩu của private key (chính là mật khẩu đã đặt khi export file .p12)
WALLET_CERT_PASSPHRASE=
# Pass Type ID + Team ID — phải khớp với chứng chỉ ký (xem subject của signerCert.pem)
WALLET_PASS_TYPE_IDENTIFIER=pass.com.pawlife.petid
WALLET_TEAM_IDENTIFIER=ZSUSA4XQ95
# Base URL trang profile pet trên web — mã QR trên thẻ = {BASE_URL}/{petId}
WALLET_PROFILE_BASE_URL=https://pawlife.vn/profile
